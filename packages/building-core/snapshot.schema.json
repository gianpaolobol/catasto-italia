{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Building Core — initial local snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "asOf",
    "sources",
    "units"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "asOf": {
      "type": "string",
      "pattern": "^[1-9][0-9]{3}-[0-9]{2}-[0-9]{2}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "maxItems": 10000
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unit"
      },
      "maxItems": 10000
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "capturedOn"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "kind": {
          "enum": [
            "document",
            "survey",
            "calculation",
            "professional_input",
            "official_receipt"
          ]
        },
        "capturedOn": {
          "type": "string",
          "pattern": "^[1-9][0-9]{3}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "municipalityCode",
        "section",
        "sheet",
        "parcel",
        "subaltern"
      ],
      "properties": {
        "municipalityCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9]+$"
        },
        "section": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[A-Za-z0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sheet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9]+$"
        },
        "parcel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9]+$"
        },
        "subaltern": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[A-Za-z0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "asOf",
        "sourceIds",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "status": {
          "enum": [
            "observed",
            "calculated",
            "proposed",
            "unknown"
          ]
        },
        "asOf": {
          "type": "string",
          "pattern": "^[1-9][0-9]{3}-[0-9]{2}-[0-9]{2}$"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "uniqueItems": true,
          "maxItems": 256
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "identifiers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "identifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "minItems": 1,
          "maxItems": 1024
        }
      }
    }
  }
}
